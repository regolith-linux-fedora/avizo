BuildRequires:  pkgconfig(gtk+-3.0)
BuildRequires:  pkgconfig(gtk-layer-shell-0)
BuildRequires:  gobject-introspection-devel
BuildRequires:  vala

Requires:       pulseaudio-utils
Requires:       light
Requires:       playerctl
Requires:       librsvg2
Recommends:     pulseaudio-utils
Provides:       avizo = %{version}-%{release}
Conflicts:      avizo

%description
mainly intended to be used for multimedia keys for
example with Sway.

%prep
%autosetup -n %{name}-%{version}

%build
%set_build_flags
%make_build -f fedora/Makefile build MESON_FLAGS="--buildtype=plain"

%install
%make_install -f fedora/Makefile PREFIX=%{_prefix} LIBDIR=%{_libdir} SYSCONFDIR=%{_sysconfdir}
# single-binary compiled package: own everything the build installed
(cd %{buildroot} && find . \( -type f -o -type l \) | sed 's|^\.||' \
   | sed -E 's|^(/usr/lib/python3[^/]*/site-packages/[^/]+)/.*|\1|; s|^(/usr/share/man/.*)$|\1*|' \
   | sort -u | sed -E 's|^(/etc/.*)$|%config(noreplace) \1|') > regolith-avizo.files

%files -f regolith-avizo.files

